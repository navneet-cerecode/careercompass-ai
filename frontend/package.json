{
  "name": "solarahire-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "24.12.0",
    "npm": "11.6.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=4",
    "test:watch": "vitest",
    "contract:export": "python ../scripts/export_openapi.py --output src/lib/api/openapi.json",
    "contract:types": "openapi-typescript src/lib/api/openapi.json -o src/lib/api/schema.d.ts",
    "contract:generate": "npm run contract:export && npm run contract:types"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "4.26.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
