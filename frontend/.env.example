# Server-only URL used by Next.js to reach FastAPI.
SOLARAHIRE_API_URL=http://127.0.0.1:8000
# Public origin used only to resolve canonical social metadata.
SOLARAHIRE_SITE_URL=http://localhost:3000

# Server-only Auth0 web-session configuration.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=replace-with-auth0-client-id
AUTH0_CLIENT_SECRET=replace-with-auth0-client-secret
AUTH0_SECRET=replace-with-64-hex-character-session-secret
APP_BASE_URL=http://localhost:3000
AUTH0_AUDIENCE=urn:solarahire:api
AUTH0_SCOPE=openid profile email offline_access
