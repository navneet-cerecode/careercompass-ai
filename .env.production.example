APP_ENVIRONMENT=production
ALLOWED_HOSTS=api,api.solarahire.example
DATABASE_URL=postgresql+psycopg://solarahire:replace-with-database-password@postgres.example:5432/solarahire
DATABASE_POOL_SIZE=5
DATABASE_POOL_TIMEOUT_SECONDS=10
REDIS_URL=rediss://default:replace-with-redis-password@redis.example:6379/0
WORKER_BROKER_NAMESPACE=solarahire
WORKER_QUEUE_NAME=solarahire
WORKER_MAX_RETRIES=3
WORKER_TIME_LIMIT_MS=300000
WORKER_MESSAGE_MAX_AGE_MS=3600000
WORKER_HEARTBEAT_SECONDS=30
TASK_STALE_AFTER_SECONDS=600
TASK_DELIVERY_RETRY_SECONDS=120
TASK_QUEUE_EXPIRY_SECONDS=1800
TASK_RETENTION_DAYS=30
TASK_MAINTENANCE_BATCH_SIZE=100
APPLICATION_REMINDER_LEAD_HOURS=24
TASK_TOKEN_SECRET=replace-with-one-shared-random-secret-of-at-least-32-bytes

AUTH_ISSUER=https://solara-hire.example.auth0.com/
AUTH_AUDIENCE=urn:solarahire:api
AUTH_JWKS_URL=https://solara-hire.example.auth0.com/.well-known/jwks.json
AUTH_JWKS_CACHE_SECONDS=300
AUTH_HTTP_TIMEOUT_SECONDS=5

GROQ_API_KEY=replace-with-groq-api-key
RAPIDAPI_KEY=replace-with-rapidapi-key
THE_MUSE_API_KEY=replace-with-the-muse-api-key
ANALYTICS_ENABLED=false
ANALYTICS_IDENTITY_SALT=replace-with-dedicated-at-least-32-random-bytes
LOG_LEVEL=INFO

APP_BASE_URL=https://app.solarahire.example
SOLARAHIRE_SITE_URL=https://app.solarahire.example
AUTH0_DOMAIN=solara-hire.example.auth0.com
AUTH0_CLIENT_ID=replace-with-auth0-client-id
AUTH0_CLIENT_SECRET=replace-with-auth0-client-secret
AUTH0_SECRET=replace-with-a-random-32-byte-session-secret
AUTH0_AUDIENCE=urn:solarahire:api
AUTH0_SCOPE=openid profile email offline_access
