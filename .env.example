GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=1024

RAPIDAPI_KEY=replace-with-your-rapidapi-key

MAX_JOBS=50
DEFAULT_LOCATION=India
MAX_RESUME_UPLOAD_BYTES=5242880
APP_ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DATABASE_URL=postgresql+psycopg://careercompass:replace-with-database-password@localhost:5432/careercompass
DATABASE_POOL_SIZE=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_PATH=database/jobs.db

# Background jobs. Redis is a broker only; PostgreSQL remains the durable source of truth.
REDIS_URL=redis://127.0.0.1:6379/0
WORKER_BROKER_NAMESPACE=careercompass
WORKER_QUEUE_NAME=careercompass
WORKER_MAX_RETRIES=3
WORKER_TIME_LIMIT_MS=300000
WORKER_MESSAGE_MAX_AGE_MS=3600000
WORKER_HEARTBEAT_SECONDS=30
TASK_STALE_AFTER_SECONDS=600
TASK_DELIVERY_RETRY_SECONDS=120
TASK_QUEUE_EXPIRY_SECONDS=1800
TASK_RETENTION_DAYS=30
TASK_MAINTENANCE_BATCH_SIZE=100
APPLICATION_REMINDER_LEAD_HOURS=24
ANALYTICS_ENABLED=false
# Optional 32+ character secret used only to pseudonymize authenticated analytics actors.
ANALYTICS_IDENTITY_SALT=replace-with-dedicated-at-least-32-random-bytes
# Set one shared random value across every API replica in production.
TASK_TOKEN_SECRET=replace-with-at-least-32-random-bytes

# Provider-neutral OIDC access-token verification.
AUTH_ISSUER=https://identity.example.com/
AUTH_AUDIENCE=urn:solarahire:api
AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
AUTH_JWKS_CACHE_SECONDS=300
AUTH_HTTP_TIMEOUT_SECONDS=5

LOG_LEVEL=INFO
